datatype AuctionMode {

	constructor { NeverStarted :: AuctionMode | Open :: AuctionMode | Closed :: AuctionMode}


	bool isClosed(AuctionMode _mode) {
		return _mode == Closed
	}

	bool isOpen(AuctionMode mode) {
		return switch mode {
			case Open: true ;
			default: false ;
		}
	}
}


datatype List {


	constructor { nil :: List | cons(int n, List l) :: List }


	bool find(List list, int element) {
		return switch list {
			case nil: false ;
			case cons(xs, e):
				switch e {
					case element: true ;
					default: find(xs, e) ;
				} ;
			default : false;
		}
	}
}

exception MyException;

interface Bidder{}
interface Owner{}

contract OneAuction {

    AuctionMode mode;
    Owner owner;
    Bidder bidder;
