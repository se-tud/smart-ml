       // );
        mode = AuctionMode.Closed;
        // Transfer the bid to the owner
        int tmp = value;
        int tmp = 3 ;
        value = 0       ;
    }
 function makeBid(int bid, Owner _bidder){
        assert(mode == AuctionMode.Open);
        assert(bid > value) ;// need to pass resources
        // Remember the old bid
        int oldBid = value;
        Bidder oldBidder = bidder;
        // Set the new bid
        value = msg.value;
        // bidder = _bidder;
        // Transfer the old bid to the old bidder
        value = bidder$10,5.closeAuction(oldBidder) ;


    }

}